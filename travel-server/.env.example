# ===== 智能旅游助手 后端环境变量示例 =====
# 使用方法：复制本文件为 .env，并填写真实配置（.env 已被 .gitignore 排除，不会提交泄露密钥）

# 服务监听端口
PORT=3300

# 大模型提供商（当前支持：deepseek-chat）
MODEL_PROVIDER=deepseek-chat

# DeepSeek API 密钥（在 https://platform.deepseek.com 创建）
DeepSeek_API_KEY=

# DeepSeek 接口地址（OpenAI 兼容协议）
DeepSeek_BASE_URL=https://api.deepseek.com/v1

# 使用的模型名称
DeepSeek_API_MODEL=deepseek-chat

# 和风天气（用于行程天气与穿着提醒，在 https://console.qweather.com 获取）
QWEATHER_API_KEY=
QWEATHER_API_HOST=
